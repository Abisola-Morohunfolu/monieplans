{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monieplans-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "monieplans_db",
      "database_name": "monieplans-db",
      "database_id": "dc613114-1ee8-45b8-8a2f-28efd62480cc"
    }
  ],
    "r2_buckets": [
      {
        "bucket_name": "monieplans-uploads",
        "binding": "monieplans_uploads"
      }
    ],
  "queues": {
    "producers": [
      { "queue": "receipt-processing", "binding": "receipt_processing" },
      { "queue": "statement-processing", "binding": "statement_processing" }
    ],
    "consumers": [
      { "queue": "receipt-processing" },
      { "queue": "statement-processing" }
    ]
  },
  "observability": { "enabled": true }
}
