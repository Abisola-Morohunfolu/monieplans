{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monieplans-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://monieplans-api.amorohunfolu.workers.dev",
    "APP_ORIGIN": "https://monieplans.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monieplans-db",
      "database_id": "dc613114-1ee8-45b8-8a2f-28efd62480cc"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
