BETTER_AUTH_SECRET=change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare D1
# For local dev, wrangler handles this automatically.
# For drizzle-kit (generate), set to local sqlite path:
DATABASE_URL=.wrangler/state/v3/d1/miniflare-D1DatabaseObject/monieplans.sqlite

# OAuth — Social Sign-On
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend — Transactional email for verification
# https://resend.com/api-keys
RESEND_API_KEY=
